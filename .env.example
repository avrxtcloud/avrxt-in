# -----------------------------------------------------------------------------
# CORE INFRASTRUCTURE (Supabase) 
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# AUTH & SITE CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://avrxt.in
NODE_ENV=development

# -----------------------------------------------------------------------------
# SPOTIFY INTEGRATION (Offloading to Supabase Edge Functions)
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your-spotify-id
SPOTIFY_CLIENT_SECRET=your-spotify-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
# Set this to your Supabase Edge Function URL to offload Vercel traffic
NEXT_PUBLIC_SPOTIFY_API_URL=https://your-project.supabase.co/functions/v1/now-playing

# -----------------------------------------------------------------------------
# STORAGE (Cloudflare R2)
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket-name
NEXT_PUBLIC_R2_IMAGE_DOMAIN=https://img.yourdomain.com
NEXT_PUBLIC_R2_VIDEO_DOMAIN=https://vid.yourdomain.com

# -----------------------------------------------------------------------------
# MAILING & NEWSLETTER (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_AUDIENCE_ID=your-audience-id

# -----------------------------------------------------------------------------
# PAYMENTS (Razorpay)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# -----------------------------------------------------------------------------
# MONITORING (Betterstack)
# -----------------------------------------------------------------------------
BETTERSTACK_API_KEY=your-betterstack-token
BETTERSTACK_STATUS_PAGE_ID=your-status-page-id

# -----------------------------------------------------------------------------
# MODERATION (Cloudflare Workers AI)
# -----------------------------------------------------------------------------
CLOUDFLARE_GUESTBOOK_MODERATION_URL=https://your-worker.workers.dev
CLOUDFLARE_GUESTBOOK_MODERATION_SECRET=your-shared-secret
CLOUDFLARE_GUESTBOOK_MODERATION_MODEL=@cf/meta/llama-3.1-8b-instruct
GUESTBOOK_MODERATION_DEGRADED_MODE=false

# -----------------------------------------------------------------------------
# COMMUNICATIONS (Discord & YouTube)
# -----------------------------------------------------------------------------
DISCORD_GUILD_ID=your-guild-id
DISCORD_ROLE_ID=your-role-id
DISCORD_TOKEN=your-bot-token
YOUTUBE_API_KEY=your-youtube-api-key

# -----------------------------------------------------------------------------
# CONTACT FORM (Gmail SMTP Fallback)
# -----------------------------------------------------------------------------
GMAIL_APP_PASSWORD=your-app-password
ADMIN_GMAIL_ID=your-email@gmail.com
