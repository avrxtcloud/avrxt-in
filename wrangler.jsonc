{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avrxt-openauth",
  "main": "auth-worker/worker.ts",
  "compatibility_date": "2026-08-19",
  "routes": [
    { "pattern": "auth.avrxt.dev", "custom_domain": true }
